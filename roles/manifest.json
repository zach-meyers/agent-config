      "inheritsOrchestratorModel": false,
      "fallbacks": {
        "cursor": "explore"
      }
    },
    {
      "id": "implementer",
      "adapterName": "toolkit-implementer",
      "promptFile": "prompts/implementer.md",
      "capabilityTier": "code-fast",
      "readOnly": false,
      "inheritsOrchestratorModel": false,
      "fallbacks": {
        "cursor": "fast-worker"
      }
    },
    {
      "id": "reviewer",
      "adapterName": "toolkit-reviewer",
      "promptFile": "prompts/reviewer.md",
